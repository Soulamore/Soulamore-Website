rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== GLOBAL FUNCTIONS ====================
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function hasCurrentUserProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return (isSignedIn() && request.auth.token != null && 'email' in request.auth.token && 
              (request.auth.token.email.lower() == 'admin@soulamore.com' || 
               request.auth.token.email.lower() == 'aditya110197@gmail.com')) 
             || (hasCurrentUserProfile() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    function isPublishedStatus(status) {
      return status in ['published', 'approved', 'public'];
    }

    // ==================== CORE USER & ROLE MANAGEMENT ====================

    // Users collection - Central profile data
    match /users/{userId} {
      allow read: if isSelf(userId) 
                  || isAdmin() 
                  || (resource != null && 'role' in resource.data && (resource.data.role.lower().matches('.*psychologist.*') || resource.data.role.lower().matches('.*peer.*')));
      allow create: if isSelf(userId);
      allow update: if isSelf(userId) 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Role verification flags (Verified Status)
    match /roles/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Practitioner metadata (Private settings/UPI)
    match /practitioner_metadata/{userId} {
      allow read, write: if isSelf(userId) || isAdmin();
    }

    // Professional Public Profiles
    match /professionals/{userId} {
      allow read: if true; // Public listings
      allow write: if isSelf(userId) || isAdmin();
    }

    // ==================== CONTENT COLLECTIONS ====================

    // Blog Posts
    match /blog_posts/{blogId} {
      allow read: if isPublishedStatus(resource.data.status) 
                  || isAdmin() 
                  || (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // Peer Stories
    match /peer_stories/{storyId} {
      allow read: if isPublishedStatus(resource.data.status) || isAdmin() || (isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Confessions (Anonymous & Private)
    match /confessions/{confId} {
      allow read: if isSignedIn();
      allow create: if true; // Anonymous posting allowed
      allow update, delete: if isAdmin();
    }

    // ==================== FINANCIAL & BOOKING ====================

    // Wallets (Plural, Singular, and Legacy support)
    match /user_wallets/{userId} { allow read, write: if isSelf(userId) || isAdmin(); }
    match /user_wallet/{userId} { allow read, write: if isSelf(userId) || isAdmin(); }
    match /wallets/{userId} { allow read, write: if isSelf(userId) || isAdmin(); }

    // Peer Bookings
    match /peer_bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.peerId == request.auth.uid));
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.paymentId == null;
      allow update: if isAdmin() || (
        isSignedIn()
        && (resource.data.userId == request.auth.uid || resource.data.peerId == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId',
          'peerId',
          'amount',
          'sessions',
          'status',
          'paymentId',
          'paymentData',
          'financials',
          'razorpayOrderId',
          'razorpayOrderAmount',
          'razorpayOrderStatus',
          'confirmedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.peerId == request.auth.uid));
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Peer Financials - earnings, bonuses, penalties
    match /peer_financials/{peerId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == peerId);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == peerId);
    }

    // Peer Reviews & Ratings
    match /peer_reviews/{reviewId} {
      allow read: if true; // Public read for transparency
      allow create: if isSignedIn(); // Any authenticated user can review
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.reviewedBy == request.auth.uid);
    }

    // Availability Schedules
    match /peer_availability/{peerId} {
      allow read: if true; 
      allow write: if isSelf(peerId) || isAdmin();
    }

    // Clinical Notes (Private to Psychologist)
    match /clinical_notes/{noteId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.psychId == request.auth.uid) ||
        (resource == null && request.resource.data.psychId == request.auth.uid) ||
        isAdmin()
      );
    }

    // Saved Items
    match /saved_items/{itemId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource == null && request.resource.data.userId == request.auth.uid)
      );
    }
    match /user_saved_items/{itemId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource == null && request.resource.data.userId == request.auth.uid)
      );
    }

    // Journal Entries (Private)
    match /journals/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /journal_entries/{entryId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }
    
    match /mood_entries/{entryId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==================== TOOLS & ENGAGEMENT ====================

    match /problem-wall-notes/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update: if true; // Reaction updates
    }

    match /active_souls/{userId} {
      allow read, write: if true; // Presence system
    }

    match /public_runtime/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tool collections - allow posting but prevent unauthorized modification/deletion
    match /vents/{id} { allow read: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if isAdmin(); }
    match /shreds/{id} { allow read: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if isAdmin(); }
    match /worries/{id} { allow read: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if isAdmin(); }
    match /echoes/{id} { allow read: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if isAdmin(); }
    match /resets/{id} { allow read: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if isAdmin(); }
    
    // Maintenance & Announcements
    match /maintenance_settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{id} { allow read: if true; allow write: if isAdmin(); }

    // Support Groups
    match /support_groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Forms - allow anyone to submit (create) but restrict management to Admins
    match /peers/{id} { allow read: if isSignedIn(); allow create: if true; allow update, delete: if isSelf(id) || isAdmin(); }
    match /psychologists/{id} { allow read: if isSignedIn(); allow create: if true; allow update, delete: if isSelf(id) || isAdmin(); }
    match /contacts/{id} { allow read: if isAdmin(); allow create: if true; allow update, delete: if isAdmin(); }
    match /newsletters/{id} { allow read: if isAdmin(); allow create: if true; allow update, delete: if isAdmin(); }
    
    // Postcards (Soulamore Away) - allow anyone to create/read postcards, restrict edit/delete to Admin
    match /postcards/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Trigger Email collection (Mail) - allow anyone to trigger email creation, restrict read/edit/delete to Admin
    match /mail/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ==================== SYSTEM & OTHERS ====================

    match /soulbot_conversations/{id} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }
    
    match /therapists/{id} { allow read: if true; allow write: if isAdmin(); }

    // Feedback - allow anyone to submit, restrict management to Admins
    match /feedback/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Safety Reports - allow creation by anyone, management only by Admin
    match /safety_reports/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Cookie Consents
    match /cookie_consents/{id} {
      allow create: if true;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Processing Consents (Wellness & Marketing decisions)
    match /processing_consents/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Parental Consents for Minors
    match /parental_consents/{id} {
      allow create: if isSignedIn() && request.resource.data.minorUserId == request.auth.uid;
      allow read, update: if true; // Accessed via verification token by external parent
      allow delete: if isAdmin();
    }

    // Deletion Requests
    match /deletion_requests/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Security Events (Breach logs)
    match /security_events/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // System Audit Logs (Admin Oversight)
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions Admin SDK can write
    }

    // Generated Slots Metadata
    match /slots/{slotId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions Admin SDK can write
    }

    // Provider Public Profiles & Moderated Edit Requests Queue
    match /providers/{providerId} {
      allow read: if true; // Public read
      allow write: if isAdmin(); // Direct live profile updates gated to Admin / Cloud Functions

      match /editRequests/{requestId} {
        allow read: if isSelf(providerId) || isAdmin();
        allow create: if isSelf(providerId) && request.resource.data.status == 'pending';
        allow update, delete: if isAdmin();
      }
    }

    // Collection Group rule for Admin Moderation Queue
    match /{path=**}/editRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource != null && resource.data.submittedBy == request.auth.uid);
    }

    // Master Specialty / Typology Tags Taxonomy
    match /specialtyTags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payout Requests (Practitioner payouts)
    match /payout_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.providerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.providerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Email Broadcast Engine (Mail Queue & Campaigns)
    match /mail_queue/{id} { allow read, write: if isAdmin(); }
    match /mail_campaigns/{id} { allow read, write: if isAdmin(); }

    // Patient SOAP Clinical Notes
    match /patient_soap_notes/{noteId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.psychologistUid == request.auth.uid || isAdmin());
    }

    // User Journals (V2 Sanctuary Reflections)
    match /user_journals/{journalId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // Profile Edit Verification Requests (Root Level V2)
    match /profile_edit_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
